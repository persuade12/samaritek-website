# SamariTek — environment variables (do not commit real secrets)

# Public site URL (no trailing slash) — used for sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://samaritek.co.zw

# --- Get started / enquiry / contact emails (SMTP) ---
# Use your cPanel "Outgoing server" for engine@samaritek.co.zw (sending only; POP3/IMAP are for reading mail in clients).
SMTP_HOST=mail.samaritek.co.zw
SMTP_PORT=465
# true for port 465 (SSL); false often for 587 + STARTTLS (see host docs)
SMTP_SECURE=true
SMTP_USER=engine@samaritek.co.zw
SMTP_PASS=

MAIL_FROM="SamariTek" <engine@samaritek.co.zw>
MAIL_TO_ENQUIRIES=enquiries@samaritek.co.zw

# Optional: rate limit for /api/contact and /api/enquiry (per IP, per server instance)
# MAIL_RATE_LIMIT_MAX=8
# MAIL_RATE_LIMIT_WINDOW_MS=900000

# --- Hosting note ---
# Next.js API routes need a Node host (e.g. Vercel). cPanel shared hosting is fine for mailboxes (MX);
# point your site DNS to Vercel (or similar) and keep email on cPanel. If SMTP from the cloud host is blocked,
# use Resend/Brevo with a verified sending domain instead.
